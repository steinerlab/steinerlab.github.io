---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@lib/utils";

export interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
}

const {
  href,
  external,
  underline = true,
  group = false,
  class: className,
  ...rest
} = Astro.props as Props & { class?: string };

const isExternal = external ?? /^(https?:)?\/\//.test(href);
const isAbsoluteInternal = !isExternal && href?.startsWith("/");
const resolvedHref = isAbsoluteInternal
  ? `${import.meta.env.BASE_URL}${href.replace(/^\//, "")}`
  : href;
---

<a
  href={resolvedHref}
  target={isExternal ? "_blank" : "_self"}
  class={cn(
    "transition-colors hover:text-water",
    underline && "underline decoration-water/40 decoration-1 underline-offset-[3px] hover:decoration-water",
    group && "group",
    className
  )}
  {...rest}
><slot /></a>
