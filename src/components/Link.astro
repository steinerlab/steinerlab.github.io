---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@lib/utils";

export interface Props extends Omit<HTMLAttributes<"a">, "href"> {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
}

const {
  href,
  external,
  underline = true,
  group = false,
  class: className,
  ...rest
} = Astro.props as Props & { class?: string };

const isExternal = external ?? /^(https?:)?\/\//.test(href);
const isAbsoluteInternal = !isExternal && href?.startsWith("/");
const resolvedHref = isAbsoluteInternal
  ? `${import.meta.env.BASE_URL}${href.replace(/^\//, "")}`
  : href;
---

<a
  href={resolvedHref}
  target={isExternal ? "_blank" : "_self"}
  class={cn(
    "inline-block decoration-teal-600/40 hover:decoration-teal-600/70 focus-visible:decoration-teal-600/70 dark:decoration-teal-400/40 dark:hover:decoration-teal-300/70 dark:focus-visible:decoration-teal-300/70 hover:text-teal-700 focus-visible:text-teal-700 dark:hover:text-teal-300 dark:focus-visible:text-teal-300 transition-colors duration-300 ease-in-out",
    underline && "underline underline-offset-[3px]",
    group && "group",
    className
  )}
  {...rest}
>
  <slot />
</a>
