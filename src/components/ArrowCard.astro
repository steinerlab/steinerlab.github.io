---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog">;
};
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="not-prose group relative flex flex-nowrap rounded-lg border border-black/15 bg-white px-4 py-3 pr-10 transition-all duration-300 ease-in-out hover:border-teal-600/40 hover:bg-black/[0.02] hover:text-black focus-visible:bg-black/5 focus-visible:text-black dark:border-white/10 dark:bg-hull/70 dark:hover:border-teal-400/50 dark:hover:bg-white/[0.03] dark:hover:shadow-[0_0_30px_-12px_rgba(45,212,191,0.4)] dark:hover:text-white dark:focus-visible:bg-white/5 dark:focus-visible:text-white"
>
  <div class="flex flex-1 flex-col truncate">
    <div class="font-display font-semibold text-black transition-colors duration-300 group-hover:text-teal-700 dark:text-slate-100 dark:group-hover:text-teal-300">
      {entry.data.title}
    </div>
    <div class="text-sm text-stone-600 dark:text-slate-400">
      {entry.data.description}
    </div>
  </div>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="absolute right-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 scale-x-0 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
    ></line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 transition-transform duration-300 ease-in-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
    ></polyline>
  </svg>
</a>
