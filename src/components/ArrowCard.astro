---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog">;
};
---

<a
  href={`/${entry.collection}/${entry.slug}`}
  class="not-prose group block py-4"
>
  <div class="font-sans text-[17px] font-semibold leading-snug text-ink underline decoration-transparent decoration-1 underline-offset-[3px] transition-colors group-hover:text-water group-hover:decoration-water/50">
    {entry.data.title}
  </div>
  <div class="mt-1 text-[16px] leading-relaxed text-muted">
    {entry.data.description}
  </div>
</a>
