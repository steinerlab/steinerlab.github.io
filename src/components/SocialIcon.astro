---
import 'bootstrap-icons/font/bootstrap-icons.css';

export interface Props {
    URL: string;
    icon: string;
    icon_size: string
}
  
const { URL, icon, icon_size } = Astro.props;
---
<a
href={URL}
target={"_blank"}
class={
`inline-block ${icon_size} decoration-teal-600/40 dark:decoration-teal-400/40 hover:decoration-teal-600/70 focus-visible:decoration-teal-600/70 dark:hover:decoration-teal-300/70 dark:focus-visible:decoration-teal-300/70 text-current hover:text-teal-700 focus-visible:text-teal-700 dark:hover:text-teal-300 dark:focus-visible:text-teal-300 transition-colors duration-300 ease-in-out`}>
<i class={`bi bi-${icon}`}></i>
</a>