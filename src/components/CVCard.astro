---
export interface Props {
    institution: string;
    time: string;
    job_title: string;
    location: string;
    description: string
  }
  
const { institution, time, job_title, location, description } = Astro.props;
---

<li class="grid gap-x-6 gap-y-1 py-5 sm:grid-cols-[7.5rem_1fr]">
    <div class="meta pt-0.5">{time}</div>
    <div class="max-w-measure">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 font-sans">
            <div class="text-[17px] font-semibold text-ink">{institution}</div>
            <div class="text-sm text-muted">{location}</div>
        </div>
        <div class="italic">{job_title}</div>
        <p class="mt-1.5 text-[16px] leading-relaxed text-muted">{description}</p>
    </div>
</li>
