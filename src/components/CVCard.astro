---
export interface Props {
    institution: string;
    time: string;
    job_title: string;
    location: string;
    description: string
  }
  
const { institution, time, job_title, location, description } = Astro.props;
---

<div class="py-5 px-8 rounded-lg border border-stone-200 bg-white dark:border-white/10 dark:bg-hull/70">
    <div class="flex justify-between text-sm font-bold md:text-lg font-display text-black dark:text-slate-100">
        <div>{institution}</div>
        <div class="font-sans font-medium text-stone-500 dark:text-slate-400">{location}</div>
    </div>
    <div class="flex justify-between text-xs md:text-base">
        <div class="italic text-stone-600 dark:text-slate-300">{job_title}</div>
        <div class="font-mono text-xs md:text-sm text-teal-700 dark:text-teal-300">{time}</div>
    </div>
    <p class="text-xs mt-2 text-stone-600 dark:text-slate-400">{description}</p>
</div>
