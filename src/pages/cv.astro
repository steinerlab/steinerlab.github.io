---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { CV } from "@consts";
import CVCard from "@components/CVCard.astro";

// TO Modify
const works = [
  {
    company: "City College of New York, CUNY",
    time: "2018-Present",
    job_title: "Research Assistant Professor (Faculty), Earth & Atmospheric Sciences",
    location: "New York, NY",
    description:
      "Lead microwave remote sensing research on wetlands, surface hydrology, and the carbon cycle; principal investigator on NASA ECOSTRESS urban forest resilience and co-investigator on NISAR, SMAP, and CYGNSS collaborations while mentoring graduate and undergraduate researchers.",
  },
  {
    company: "CUNY Advanced Science Research Center",
    time: "2021-Present",
    job_title: "Affiliate Professor, Environmental Sciences Initiative",
    location: "New York, NY",
    description:
      "Integrate satellite observations with urban climate resilience partnerships, connecting CUNY expertise with city agencies on environmental health questions and stewarding interdisciplinary research teams.",
  },
  {
    company: "Jet Propulsion Laboratory, Caltech",
    time: "2016",
    job_title: "Visiting Research Faculty",
    location: "Pasadena, CA",
    description:
      "Supported NISAR validation strategies and synthetic aperture radar applications for surface hydrology while collaborating with mission scientists.",
  },
  {
    company: "City College of New York, CUNY",
    time: "2012-2016",
    job_title: "Postdoctoral Research Scientist",
    location: "New York, NY",
    description:
      "Developed soil moisture retrieval and freeze/thaw monitoring algorithms for NASA SMAP and Arctic Boreal Vulnerability Experiment (ABoVE) campaigns.",
  },
];
const educations = [
  {
    school: "The Graduate Center, CUNY",
    time: "2008-2012",
    job_title: "Ph.D., Earth and Environmental Sciences",
    location: "New York, NY",
    description:
      "Dissertation on monitoring surface melt processes on ice sheets under the supervision of Prof. Marco Tedesco.",
  },
  {
    school: "The City College of New York, CUNY",
    time: "2005-2007",
    job_title: "M.A., Earth and Atmospheric Sciences",
    location: "New York, NY",
    description:
      "Focused on applying remote sensing approaches to hydrological process studies.",
  },
  {
    school: "University of Colorado, Boulder",
    time: "2000-2004",
    job_title: "B.A., Arts and Sciences",
    location: "Boulder, CO",
    description:
      "Interdisciplinary coursework across environmental science and geography.",
  },
];

const awards = [
  {
    title: "NASA Group Achievement Award",
    year: "2014",
    description: "Carbon in the Arctic Vulnerability Experiment (CARVE) Airborne Science Campaign.",
  },
  {
    title: "Research support portfolio",
    year: "2025",
    description: "$4.28M awarded ($0.84M as lead PI) across NASA Earth Science, NSF, and agency partnerships through October 2025.",
  },
];

const supports = [
  {
    title: "NASA CESRA HiFLOWS",
    amount: "$352K",
    role: "Principal Investigator",
    year: "2025",
    description: "High-Latitude Flood and Open Water Surveillance delivering rapid-tasked SAR flood intelligence for Alaska.",
  },
  {
    title: "NSF BoCP Implementation: Functional responses to environmental change in South American transitional ecosystems",
    amount: "$778K",
    role: "Co-Principal Investigator",
    year: "2025 (submitted)",
    description: "Collaborative effort to couple field ecology with remote sensing diagnostics for transitional biomes.",
  },
  {
    title: "NASA NISAR Operations Science Team",
    amount: "$368K",
    role: "Co-Investigator",
    year: "2024",
    description: "Validating wetlands inundation and freeze/thaw algorithms for the global NISAR mission.",
  },
  {
    title: "MSSM/CUNY Climate Change Health Initiative",
    amount: "$50K",
    role: "CUNY Principal Investigator",
    year: "2023",
    description: "Evaluating environmental disparities and West Nile virus risk across New York City.",
  },
  {
    title: "NASA ECOSTRESS Urban Forest Resilience",
    amount: "$378K",
    role: "Lead Investigator",
    year: "2022",
    description: "Fine-resolution assessment of heat mitigation and water stress in New York City urban forests.",
  },
  {
    title: "NASA CYGNSS: Methane emissions from tropical wetlands",
    amount: "$664K",
    role: "Co-Investigator",
    year: "2021",
    description: "Linking GNSS-R inundation retrievals with methane flux assessments to quantify carbon cycle feedbacks.",
  },
  {
    title: "NASA HMA: Assessing Impacts of Climate-Induced Change on River Flow and Economic Output",
    amount: "$1.04M",
    role: "Co-Investigator",
    year: "2016",
    description: "Established baseline glacier melt monitoring across the Hindu Kush Himalaya through large-scale SAR analyses.",
  },
];
---

<Layout title={CV.TITLE} description={CV.DESCRIPTION}>
  <Container>
      <h1 class="font-sans text-[2.4rem] font-extrabold leading-[1.05] tracking-[-0.03em] text-ink sm:text-[3rem]">CV</h1>
      <div class="mt-12 space-y-16">
        <section>
          <h2 class="section-title">Work Experience</h2>
          <ul class="not-prose ruled border-y border-rule">
            {works.map((work) => (
                <CVCard institution={work.company} time={work.time} job_title={work.job_title} location={work.location} description={work.description} />)
            )}
          </ul>
        </section>
        <section>
          <h2 class="section-title">Education</h2>
          <ul class="not-prose ruled border-y border-rule">
            {educations.map((education) => (
              <CVCard institution={education.school} time={education.time} job_title={education.job_title} location={education.location} description={education.description} />)
          )}
          </ul>
        </section>
        <section>
          <h2 class="section-title">Awards</h2>
          <ul class="not-prose ruled border-y border-rule">
            {awards.map((award) => (
              <li class="grid gap-x-6 gap-y-1 py-5 sm:grid-cols-[7.5rem_1fr]">
                <p class="meta pt-0.5">{award.year}</p>
                <div class="max-w-measure">
                  <p class="font-sans text-[17px] font-semibold text-ink">{award.title}</p>
                  <p class="mt-1 text-[16px] text-muted">{award.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
        <section>
          <h2 class="section-title">Selected research support</h2>
          <ul class="not-prose ruled border-y border-rule">
            {supports.map((project) => (
              <li class="grid gap-x-6 gap-y-1 py-5 sm:grid-cols-[7.5rem_1fr]">
                <p class="meta pt-0.5">{project.year}</p>
                <div class="max-w-measure">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                    <p class="font-sans text-[17px] font-semibold leading-snug text-ink">{project.title}</p>
                    <span class="meta">{project.amount}</span>
                  </div>
                  <p class="mt-1 text-[16px] text-muted">
                    {project.role}. {project.description}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </div>
  </Container>
</Layout>
