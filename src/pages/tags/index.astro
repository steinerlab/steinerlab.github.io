---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { TAGS } from "@consts";
import Image from "astro/components/Image.astro";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft);

const tags =  blog.flatMap(post => post.data.tags).filter((tag, index, self) => self.indexOf(tag) === index);
---

<Layout title={TAGS.TITLE} description={TAGS.DESCRIPTION}>
  <Container>
      <div class="space-y-10">
        <h1 class="font-sans text-[2.4rem] font-extrabold leading-[1.05] tracking-[-0.03em] text-ink sm:text-[3rem]">
          Tags
        </h1>
        <ul class="flex flex-wrap gap-2">
            {tags.map(tag => (
              <li>
                <a href={`/tags/${tag}`} class="tag">
                    #{tag}
                </a>
              </li>
            ))}
        </ul>
      </div>
  </Container>
</Layout>
