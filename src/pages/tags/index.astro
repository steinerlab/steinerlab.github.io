---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { TAGS } from "@consts";
import Image from "astro/components/Image.astro";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft);

const tags =  blog.flatMap(post => post.data.tags).filter((tag, index, self) => self.indexOf(tag) === index);
---

<Layout title={TAGS.TITLE} description={TAGS.DESCRIPTION}>
  <Container>
      <div class="space-y-10">
        <div class="animate font-display font-semibold tracking-tight text-black dark:text-slate-100">
          Tags
        </div>
        <ul class="flex flex-wrap ">
            {tags.map(tag => (
              <li class="my-3">
                <a href={`/tags/${tag}`} class="px-3 py-2 rounded-full mx-2 border border-teal-600/25 bg-teal-600/10 text-teal-800 hover:bg-teal-600/20 dark:border-teal-400/25 dark:bg-teal-400/10 dark:text-teal-300 dark:hover:bg-teal-400/20 transition-colors duration-300 ease-in-out">
                    #{tag}
                </a>
              </li>
            ))}
        </ul>
      </div>
  </Container>
</Layout>
